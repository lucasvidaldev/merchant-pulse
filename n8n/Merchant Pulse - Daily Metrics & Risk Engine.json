      "id": "559693f2-471c-446f-b3b6-258916eba295",
      "name": "1. Buscar Merchants Ativos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-208, 304]
    },
    {
      "parameters": {
        "jsCode": "const today = new Date().toISOString().slice(0, 10);\n\nreturn items.map((item) => {\n  const m = item.json;\n  const totalOrders = Math.floor(45 + Math.random() * 140);\n  const isSpike = Math.random() < 0.2;\n  const cancellationRate = Number((isSpike ? (9 + Math.random() * 8) : (1.5 + Math.random() * 4.5)).toFixed(1));\n  const canceledOrders = Math.max(0, Math.round((totalOrders * cancellationRate) / 100));\n  const avgPrepTime = Number((isSpike ? (36 + Math.random() * 14) : (18 + Math.random() * 12)).toFixed(1));\n  const avgRating = Number((isSpike ? (3.4 + Math.random() * 0.7) : (4.4 + Math.random() * 0.55)).toFixed(1));\n\n  const rawScore = cancellationRate * 4.2 + Math.max(0, avgPrepTime - 20) * 1.1 + Math.max(0, 4.6 - avgRating) * 18;\n  const riskScore = Math.min(97, Math.max(12, Math.round(rawScore)));\n  const riskLevel = riskScore >= 80 ? 'critical' : riskScore >= 60 ? 'high' : riskScore >= 40 ? 'medium' : 'low';\n\n  return {\n    json: {\n      merchant_id: m.id,\n      merchant_name: m.name,\n      metric_date: today,\n      total_orders: totalOrders,\n      canceled_orders: canceledOrders,\n      cancellation_rate: cancellationRate,\n      avg_prep_time: avgPrepTime,\n      avg_rating: avgRating,\n      risk_score: riskScore,\n      risk_level: riskLevel,\n      diagnosis: riskScore >= 80\n        ? `Alerta crítico em ${m.name}: cancelamentos em ${cancellationRate}% e preparo médio de ${avgPrepTime} min exigem ação imediata.`\n        : riskScore >= 60\n        ? `Risco elevado em ${m.name}: aumento no tempo de preparo (${avgPrepTime} min) pressionando a nota (${avgRating}).`\n        : `Operação dentro do SLA em ${m.name}: cancelamento de ${cancellationRate}% e preparo médio de ${avgPrepTime} min.`\n    }\n  };\n});"
      },
      "id": "d3ffd160-3614-48c2-b917-ce7fdfda3f7d",
      "name": "2. Calcular Métricas & Score de Risco",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [32, 304]
    },
