            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"merchant_id\": \"{{ $json.merchant_id }}\",\n  \"metric_date\": \"{{ $json.metric_date }}\",\n  \"total_orders\": {{ $json.total_orders }},\n  \"canceled_orders\": {{ $json.canceled_orders }},\n  \"cancellation_rate\": {{ $json.cancellation_rate }},\n  \"avg_prep_time\": {{ $json.avg_prep_time }},\n  \"avg_rating\": {{ $json.avg_rating }}\n}",
        "options": {}
